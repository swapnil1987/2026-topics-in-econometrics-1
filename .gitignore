# Documentation: keep README files, ignore other Markdown notes.
*.md
!README.md

# Generated/local content directories
/quiz_generation/
/book/

# R and Quarto working files
.Rhistory
.RData
.Ruserdata
.Rproj.user/
slides/.quarto/
slides/_site/
slides/_freeze/
slides/**/*_cache/
slides/**/*_files/
*.utf8.md

# Python caches
__pycache__/
*.py[cod]

# Local build and Codex scratch outputs
.codex_tmp/
tmp/
output/
outputs/

# Weekly quiz content is private/local until the instructor explicitly approves a push.
# Placeholder README files remain tracked so the repository structure is visible.
quiz/quiz[0-9]*/**
!quiz/quiz[0-9]*/README.md

# Quiz 1 materials linked from the course README.
!quiz/quiz1/quiz1_five_forms.pdf
!quiz/quiz1/quiz1_instructor_key.pdf

# Quiz 2 solutions linked from the course README.
!quiz/quiz2/quiz2_instructor_key.pdf

# Quiz 3 solutions linked from the course README.
!quiz/quiz3/quiz3_instructor_key.pdf

# Never commit raw live-student scans by default.
quiz/**/raw_scans/
quiz/**/scans/

# Keep midterm sources, scans, and grading audits private; release only authorized PDFs.
/quiz/midterm/**
!/quiz/midterm/revision1/
/quiz/midterm/revision1/**
!/quiz/midterm/revision1/midterm_five_forms.pdf
!/quiz/midterm/revision1/midterm_instructor_key.pdf

# Unreleased makeup quiz forms and instructor keys are private/local.
/quiz/makeup/

# Main Quiz 3 and Quiz 4 papers and solutions authorized for release.
!quiz/quiz3/quiz3_five_forms.pdf
!quiz/quiz4/quiz4_five_forms.pdf
!quiz/quiz4/quiz4_instructor_key.pdf
